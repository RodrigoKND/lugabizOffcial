# Supabase Configuration
VITE_SUPABASE_URL="Your Supabase URL here"
VITE_SUPABASE_ANON_KEY="Your Supabase Anon Key here"

# Geoapify — autocompletado de direcciones en los formularios.
# Crea una clave en https://myprojects.geoapify.com y RESTRÍNGELA por dominio
# (Allowed Origins/Referrers) para evitar abuso, ya que es visible en el frontend.
# Si se deja vacía, el autocompletado cae automáticamente a OpenStreetMap/Nominatim.
VITE_GEOAPIFY_API_KEY="Your Geoapify API key here"

# Push del navegador — Web Push nativo (VAPID), servido por el backend propio
# lugabizPushServer (ya NO Firebase). La pública se genera junto con la
# privada del servidor (par criptográfico único, ver lugabizPushServer/.env.example).
VITE_VAPID_PUBLIC_KEY="Your VAPID public key here"

# URL del servidor propio de notificaciones (Downloads/lugabizPushServer).
# Local: http://localhost:8000 — Producción: el dominio de Vercel del backend.
VITE_PUSH_SERVER_URL="http://localhost:8000"
